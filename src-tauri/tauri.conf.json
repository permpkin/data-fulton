{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataFulton",
  "version": "0.1.1",
  "identifier": "com.datafulton.extractor",
  "build": {
    "frontendDist": "../dist-renderer",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
